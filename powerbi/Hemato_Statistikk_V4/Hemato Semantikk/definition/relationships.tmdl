relationship ResultaterInfo
	fromColumn: resultater.Analyse
	toColumn: info.Analyse

relationship AntallInfo
	fromColumn: antall.Analyse
	toColumn: info.Analyse

relationship Resultatdato
	fromColumn: resultater.'Analyseresultat dato'
	toColumn: Dato.Date

