	fromColumn: resultater.'Prøvetaking dato'
	toColumn: Dato.Date

relationship BestillingsdatoResultat
	isActive: false
	fromColumn: resultater.'Analysebestilling dato'
	toColumn: Dato.Date

relationship Godkjenningsdato
	isActive: false
	fromColumn: resultater.'Godkjenning dato'
	toColumn: Dato.Date

relationship BestillingsdatoVolum
	fromColumn: antall.'Analysebestilling dato'
	toColumn: Dato.Date
