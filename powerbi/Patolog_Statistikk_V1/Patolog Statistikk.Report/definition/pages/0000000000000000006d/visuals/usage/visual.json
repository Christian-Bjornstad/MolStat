            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Filtrering og antall",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "17pt",
                      "color": "#0B4F7A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Velg år, måned, uke, faggruppe og lege. Hovedansvarlig er valgt ved åpning.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Antall viser unike prøver. En prøve kan inngå hos flere leger og i flere roller.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Summen av lege-, rolle- eller uketall er derfor ikke alltid lik totalen.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Legesidene starter med HEMATO. Bytt faggruppe for å se andre leger.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#172B3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Uke følger mandag–søndag. Første og siste uke i uttrekket er ufullstendige.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#526579"
                    }
                  }
                ]
              }
            ]
          }
        }
