DimDato =
VAR MinDato = MINX ( FactRestanse, FactRestanse[Dato] )
VAR MaksDato = MAXX ( FactRestanse, FactRestanse[Dato] )
RETURN
    ADDCOLUMNS (
        CALENDAR ( MinDato, MaksDato ),
        "År", YEAR ( [Date] ),
        "MånedNr", MONTH ( [Date] ),
        "Måned", FORMAT ( [Date], "YYYY-MM" ),
        "Uke", WEEKNUM ( [Date], 2 )
    )

DimAnalysegruppe =
SUMMARIZE (
    FactRestanse,
    FactRestanse[Analysegruppe_kode],
    FactRestanse[Analysegruppe]
)

Siste observerte tidspunkt =
CALCULATE (
    MAX ( FactRestanse[Observert_tidspunkt] ),
    REMOVEFILTERS ( DimDato ),
    REMOVEFILTERS ( FactRestanse[Dato] ),
    REMOVEFILTERS ( FactRestanse[Observert_tidspunkt] )
)

Klar nå =
VAR SisteTid = [Siste observerte tidspunkt]
RETURN CALCULATE ( SUM ( FactRestanse[Klar] ), KEEPFILTERS ( FactRestanse[Observert_tidspunkt] = SisteTid ) )

Mangler godkjenning nå =
VAR SisteTid = [Siste observerte tidspunkt]
RETURN CALCULATE ( SUM ( FactRestanse[Mangler_godkjenning] ), KEEPFILTERS ( FactRestanse[Observert_tidspunkt] = SisteTid ) )

På vei nå =
VAR SisteTid = [Siste observerte tidspunkt]
RETURN CALCULATE ( SUM ( FactRestanse[På_vei] ), KEEPFILTERS ( FactRestanse[Observert_tidspunkt] = SisteTid ) )

Total restanse nå = [Klar nå] + [Mangler godkjenning nå] + [På vei nå]

Over frist nå =
VAR SisteTid = [Siste observerte tidspunkt]
RETURN CALCULATE ( SUM ( FactRestanse[Over_frist] ), KEEPFILTERS ( FactRestanse[Observert_tidspunkt] = SisteTid ) )

Eldste klare timer nå =
VAR SisteTid = [Siste observerte tidspunkt]
RETURN CALCULATE ( MAX ( FactRestanse[Eldste_klare_timer] ), KEEPFILTERS ( FactRestanse[Observert_tidspunkt] = SisteTid ) )

Klar ved tidspunkt = SUM ( FactRestanse[Klar] )
Mangler godkjenning ved tidspunkt = SUM ( FactRestanse[Mangler_godkjenning] )
På vei ved tidspunkt = SUM ( FactRestanse[På_vei] )
Over frist ved tidspunkt = SUM ( FactRestanse[Over_frist] )
